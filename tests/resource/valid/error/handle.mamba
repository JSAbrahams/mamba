class MyErr1: Exception("Something went wrong")
class MyErr2(msg: Str): Exception(msg)

def f(x: Int) -> Int ! { MyErr1, MyErr2 } :=
    if x < 0 then
        ! MyErr1()
    else
        if x > 10 then
            ! MyErr2("Greater than 10.")
        else
            return x + 2

def a := f(10) ! where
    err: MyErr1 => do
        print("Something went wrong")
        -1
    end
    err: MyErr2 => do
        print("Something else went wrong")
        -2
    end
end
