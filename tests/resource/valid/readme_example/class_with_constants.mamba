class Point2D(ORIGIN_X: Int, ORIGIN_Y: Int) where
    let mut x: Int := self.ORIGIN_X
    let mut y: Int := self.ORIGIN_Y

    def move(mut self, dx: Int, dy: Int) := do
        self.x := self.x + dx
        self.y := self.y + dy
    end

    # Reset moves this point back to where it was when it was made.
    def reset(mut self) := do
        self.x := self.ORIGIN_X
        self.y := self.ORIGIN_Y
    end

    def info(self) -> Str :=
        "Currently at ({self.x}, {self.y}), originally from ({self.ORIGIN_X}, {self.ORIGIN_Y})"
end

let mut p := Point2D.new(1, 2)
p.move(3, 4)
print(p.info()) # prints 'Currently at (4, 6), originally from (1, 2)'
