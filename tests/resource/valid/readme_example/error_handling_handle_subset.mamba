def a: Result[Int, MyErr] := function_may_throw_err() ! {
    err: MyOtherErr => [
        print("We have another problem: {err.message}.")
        0  # ... or we assign default value 0 to a
    ]
}

a = a ! # Result[Int, MyErr] => Int, where if error case, an exception is raised.

print("a has value {a}.")
