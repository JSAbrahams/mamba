# Factorial of x
def factorial(x: Int) -> Int := match x with
    0 => 1
    n => n * factorial(n - 1)
end

def num := input("Compute factorial: ")
if num.is_digit() then do
    def result := factorial(Int(num))
    print("Factorial {num} is: {result}.")
end else
    print("Input was not an integer.")
