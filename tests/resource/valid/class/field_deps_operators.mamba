class Deps(x: Int) where
    let cmp: Bool := self.x < self.later
    let eqcmp: Bool := self.x = self.later
    let geqcmp: Bool := self.x >= self.later
    let logic: Bool := self.cmp or self.eqcmp
    let logic2: Bool := self.cmp and self.eqcmp
    let notv: Bool := not self.cmp
    let negv: Int := -self.later
    let posv: Int := +self.later
    let subv: Int := self.x - self.later
    let modv: Int := self.x mod self.later
    let powv: Int := self.x ^ self.later
    let divv: Float := self.x / self.later
    let fdivv: Int := self.x // self.later
    let inv: Bool := self.x in [self.later]
    let later: Int := self.x * 2
end

let d := Deps.new(3)
print(d.cmp)
