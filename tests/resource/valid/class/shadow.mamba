class MyClass1 where
    def f1(self) := print("1")
end
class MyClass2 where
    def f2(self) := print("2")
end
class MyClass3 where
    def f3(self) := print("3")
end
class MyClass4 where
    def f4(self) := print("4")
end

def x := MyClass1()
x.f1()

def x := MyClass2()
x.f2()

class MyClass where
    def x: MyClass3 := MyClass3()

    def g() :=
        x.f3()

    def f(x: MyClass4) :=
        x.f4()
end
