class Deps2(x: Int) where
    let gt: Bool := self.x > self.later
    let leq: Bool := self.x <= self.later
    let sq: Float := self.later / 2
    let tup: (Int, Int) := (self.x, self.later)
    let st: Set[Int] := { self.x, self.later }
    let dc: Dict[Int, Int] := { self.x => self.later }
    let ifv: Int := if self.gt then self.x else self.later
    let later: Int := self.x * 2
end

let d := Deps2.new(3)
print(d.gt)
