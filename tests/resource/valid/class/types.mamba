class MyGeneric: Str

trait SuperInterface where
    def bar: Int
end

trait MyInterface: SuperInterface where
    def required_field: Int
    def higher_order(self) -> Int
end

# some class
class MyClass(my_field: Int, other_field: Str := "Hello"): MyInterface where
    def required_field: Int := 100
    def private_field: Int := 20

    def fun_a(self) := self.other_field := "my field is {self.required_field}"
    def fun_b(self) := print("this field is private: {self.private_field}!")

    def some_higher_order(self, fun: Int -> Int) -> Int := return fun(self.my_field)
    def higher_order(self) -> Int := return self.some_higher_order(\x: Int := x * 2)
end
