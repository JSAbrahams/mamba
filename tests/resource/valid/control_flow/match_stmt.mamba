let a := "d"

let (b, bb, bbb) := (0, 1, 2)

match (b, bb, bbb) where
    (0, 1, 2) => print("hello world")
end

let nested := "other"

match nested where
    "a" => do
        "b"
        "c"
    end
    "c" => match nested where
        "other" => "even_other"
        "other_one" => "better_one"
        _ => "default"
    end
end
