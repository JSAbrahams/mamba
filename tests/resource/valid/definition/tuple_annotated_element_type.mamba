class MyClass where
    let mut my_field: Int := 10
end

# An annotated tuple keeps each element's type, the same way an annotated single
# binding does, so a method may be resolved on an element
let (a, b): (Int, Str) := (10, "hi")
print(b)
let c := a + 1

# including when the element is a class, and when there is no right hand side
let (d, e): (MyClass, Int) := (MyClass.new(), 10)
print(d.my_field)
