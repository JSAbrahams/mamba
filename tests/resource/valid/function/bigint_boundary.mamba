def largest := 4611686018427387903
def smallest: Int := -4611686018427387904
def one := 1
def above := largest + one
def below := smallest - one
print(above)
print(below)
print(above - one)
print(below + one)
print(largest * largest)
print(smallest * smallest)
def negated: Int := -smallest
print(negated)
